# ==============================================================================
# Minimi Chat Agent — Environment Configuration
# ==============================================================================
# Zero-Key Ready: If no keys are provided, the agent defaults to:
# 1. Built-in DuckDuckGo Web Search (100% Free, zero API key needed).
# 2. Autonomous Episodic Verification Engine (Zero cost, no credit card).
#
# To use external cloud providers, provide any of the following keys:
# ==============================================================================

# LLM Providers (Pick any or leave empty for free autonomous mode):
# 1. Groq (Free tier, fast 300+ tokens/sec, get key at https://console.groq.com):
GROQ_API_KEY=

# 2. OpenAI (gpt-4o-mini, get key at https://platform.openai.com):
OPENAI_API_KEY=

# Web Search Providers (Optional):
# Tavily Search API (1,000 free searches/mo at https://tavily.com):
# If left blank, the agent automatically falls back to DuckDuckGo Free Search!
TAVILY_API_KEY=
